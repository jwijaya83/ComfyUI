# Build context trimming. The ComfyUI dir is ~70 GB; this gets it under ~1 GB.
#
# NOTE: .dockerignore applies to the whole context, i.e. to BOTH stages. The
# builder stage needs requirements.txt, install.sh, custom_nodes/ and the
# SageAttention *source*, so none of those may be excluded here.

.git
.github
**/__pycache__
**/*.pyc
*.log

# Never bake credentials into a layer. HF_TOKEN / GCS keys are passed at RUN
# time (compose environment, RunPod secrets), never at build time.
.env
.env.*
*.pem
*-key.json

# ---------------------------------------------------------------- models ----
# Nothing under models/ is baked any more. Locally they are bind-mounted from
# the host (see docker-compose.test.yml); in production they come from the
# network volume / HF cache via runpod_worker/fetch_models.py.
models/
# Local HF cache created by docker-compose.test.yml (tens of GB).
.hf-cache/

# ------------------------------------------------------------------ venv ----
# The image builds its own venv at /opt/venv via install.sh. The host venv is
# 6.2 GB and hardcodes a stale absolute path in bin/activate — never ship it.
venv/
# Local handler venv used to test the handler/GCS upload off-RunPod (mirrors the
# container's /opt/handler-venv). The image builds its own.
**/.venv/

# --------------------------------------------------------- SageAttention ----
# Keep the source (the builder compiles it), drop the bulk. build/ in particular
# is a stale HOST artifact tree — shipping it into the builder risks reusing
# objects compiled against the host's arch/torch instead of a clean rebuild.
SageAttention/build/
SageAttention/assets/
SageAttention/example/
SageAttention/bench/
SageAttention/*.egg-info/

# -------------------------------------------------------------- runtime I/O --
# Bind-mounted at run time, not baked. input/ alone is ~300 MB.
input/
output/
training_output/

# --------------------------------------------------------------- dev only ----
tests/
tests-unit/
.ci/
Dockerfile
.dockerignore
docker-compose.test.yml
